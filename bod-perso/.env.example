# BOD Perso — variables d'environnement (copier en .env, ne JAMAIS committer .env)
# Les identifiants DataForSEO ne vont PAS ici : ils sont dans Secret Manager
# (secrets `dataforseo-login` et `dataforseo-password`).

# --- Google Cloud -----------------------------------------------------------
PROJECT_ID=bod-perso-123
REGION=europe-west1
BQ_LOCATION=EU
BQ_DATASET=bod
# Par défaut : gs://<PROJECT_ID>-raw
# RAW_BUCKET=bod-perso-123-raw

# --- Vertex AI (noms de modèles à vérifier dans ta région) ------------------
VERTEX_LOCATION=europe-west4
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-multilingual-embedding-002
EMBEDDING_BATCH_SIZE=50

# --- Pipeline ---------------------------------------------------------------
# init | collect | cluster | opportunities | simulate | serp | all
STAGE=collect
MARKETS=FR,US
# Fichier JSON {"FR": ["terme 1", ...], "US": [...]} ; défaut : seeds intégrés
# SEEDS_FILE=seeds.example.json

# --- Contrôle des coûts DataForSEO ------------------------------------------
# Plafond de dépense PAR EXÉCUTION (USD). Arrêt immédiat une fois atteint.
MAX_COST_USD=5
DFS_LOGIN_SECRET=dataforseo-login
DFS_PASSWORD_SECRET=dataforseo-password
DFS_RETRIES=3
DFS_TIMEOUT_S=180

# --- Collecte ---------------------------------------------------------------
# keyword_ideas,keyword_suggestions,related_keywords
COLLECT_ENDPOINTS=keyword_ideas
COLLECT_LIMIT=700
MIN_SEARCH_VOLUME=50
FILL_MISSING_INTENT=false

# --- Clustering -------------------------------------------------------------
KEYWORD_LOOKBACK_DAYS=35
INCLUDE_INFORMATIONAL=false
MIN_CLUSTER_SIZE=8
MAX_KEYWORDS_TO_EMBED=20000
# EXCLUDE_TERMS=login,connexion,gratuit,amazon

# --- Opportunités / simulation ---------------------------------------------
MAX_CLUSTERS_FOR_LLM=300
OPPORTUNITY_LOOKBACK_DAYS=30
# Conversion des CPC fournisseur (USD) en EUR — hypothèse, à mettre à jour
USD_TO_EUR=0.92
TEST_BUDGET_EUR=180
MAX_TEST_CPC_EUR=2
MIN_TEST_MAX_CPA_EUR=30

# --- SERP (top opportunités uniquement) -------------------------------------
SERP_TOP_N=10
SERP_KEYWORDS_PER_OPPORTUNITY=3
SERP_MAX_CALLS=30
SERP_DEPTH=20
SERP_DEVICE=desktop
SERP_REFRESH_DAYS=7
SERP_SHOPPING=false
